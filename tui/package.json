{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@shift/cli-tui",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/index.tsx",
    "start": "bun src/index.tsx",
    "format:check": "prettier --check scripts src test package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "test:node": "node --experimental-strip-types --test test/node-smoke.test.ts",
    "build": "bun run scripts/build.ts --single",
    "build:all": "bun run scripts/build.ts"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "prettier": "3.6.2",
    "typescript": "5.8.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
